<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_background</item>
    </style>

    <style name="AppTheme.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper_background_dark</item>
    </style>

    <!-- Shown until the saved theme has loaded (see MainActivity and StartupTheme). -->
    <style name="AppTheme.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="AppTheme.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/paper_background_dark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.Dark</item>
    </style>
</resources>
